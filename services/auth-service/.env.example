# Copy to .env and fill in real values for local dev. Never commit .env.
#
# Every one of these is checked at startup (src/config/env.ts) — a missing
# DATABASE_URL or JWT_SECRET makes this service refuse to start rather than
# boot in a half-configured state (Security_context.md Section 2.C).

PORT=4001
DATABASE_URL=postgres://glide:glide@localhost:5432/glide_auth
JWT_SECRET=replace-with-a-long-random-secret

# Optional — sane defaults are in src/config/env.ts if these are omitted.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SEND_RATE_LIMIT_PER_HOUR=5
