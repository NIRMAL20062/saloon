# macOS
.DS_Store
*.pem

# local env / secret files — never commit real Supabase/Razorpay values
.env
.env*.local

# Supabase CLI's local cache/link state (project ref, service version pins,
# etc.) — regenerated per-machine by `supabase link`/`db push`, not part of
# the actual project schema. Never meant to be version-controlled.
supabase/.temp/

# android-native/ has its own .gitignore for Gradle/build artifacts.
