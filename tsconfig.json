{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // supabase/functions runs on Deno, not Node — Deno.serve/Deno.env and the
  // https:// URL imports it uses aren't valid to this project's Node-based
  // tsc/tsconfig at all, and are checked separately (by Deno itself, at
  // `supabase functions deploy` time), not by this app's typecheck.
  // `_shared/booking-logic.ts` is the one file in that tree with no
  // Deno-specific code — Jest imports it directly and can still typecheck it
  // in isolation despite this exclude (ts-jest transforms per-file, it
  // doesn't consult this project's include/exclude list).
  "exclude": ["supabase/functions/**/*"]
}
